{
  "name": "referral-frontend",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @referral/web dev",
    "dev:admin": "pnpm --filter @referral/admin dev",
    "build": "pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r --filter './apps/*' typecheck",
    "test:e2e": "playwright test",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
